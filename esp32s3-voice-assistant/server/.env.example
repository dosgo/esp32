# 复制成 .env 然后填自己的 key
# Windows:  copy .env.example .env
# Linux/Mac: cp .env.example .env

# ---- 硅基流动（必填，ASR 用它，语音识别免费）----
# 注册：https://cloud.siliconflow.cn  需实名认证
# 创建 Key：https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=

# ---- ASR 降级链，按顺序尝试 ----
#   local       : sherpa-onnx（C++），最快 ~60ms，但 wheel 只能装在电脑上
#   local-lite  : 纯 Python 自实现（sensevoice_lite.py），~73ms，**手机也能跑**
#   siliconflow : 云端 SenseVoice，免费额度，~400ms，不用下载模型
# 三者跑的是**同一个模型**（SenseVoice），只是实现方式和部署位置不同。
# 默认链路会自动跳过当前环境装不上的那个，不用手动改。
ASR_CHAIN=local,local-lite,siliconflow

# ---- LLM 后端：siliconflow（便宜）| deepseek ----
LLM_BACKEND=siliconflow
# 用 deepseek 时才需要
DEEPSEEK_API_KEY=

# ---- TTS 降级链，按顺序尝试 ----
#   siliconflow : CosyVoice2，¥0.5/万字符，质量最好
#   piper       : 本地免费离线，最快（325ms/4.6s），音质中等
#   kokoro      : 本地免费离线，音质比 piper 好一档，但慢 6 倍（1.7s/3.9s）
#   edge        : 微软 Edge 语音，免费但国内要代理 + 需要 ffmpeg
# 想绝对零成本 → 改成 "piper"
# 想音质优先   → "siliconflow,piper"（云端挂了自动降级本地）
TTS_CHAIN=siliconflow,piper

# ---- Piper 语速：1.0 正常，0.9 更快，1.2 更慢 ----
PIPER_LENGTH_SCALE=1.0

# ---- Kokoro 音色（TTS_CHAIN 里有 kokoro 才生效）----
# 女声：zf_xiaobei / zf_xiaoni / zf_xiaoxiao / zf_xiaoyi
# 男声：zm_yunjian / zm_yunxi / zm_yunxia / zm_yunyang
KOKORO_VOICE=zf_xiaobei
KOKORO_SPEED=1.0

# ---- 硅基流动音色（TTS 用）----
# 可选：anna / bella / claire / diana / benjamin / charles / david
SF_TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:anna

# ---- 网关端口 ----
GATEWAY_PORT=8765

# ---- 只有启用 edge TTS 才需要 ----
# EDGE_PROXY=http://127.0.0.1:10808
